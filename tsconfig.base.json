{
  "compilerOptions": {
    "paths": {
      "@adventure/config": ["./packages/config/src/index.ts"],
      "@adventure/config/*": ["./packages/config/src/*"],
      "@adventure/core": ["./packages/core/src/index.ts"],
      "@adventure/core/*": ["./packages/core/src/*"],
      "@adventure/mapgen": ["./packages/mapgen/src/index.ts"],
      "@adventure/mapgen/*": ["./packages/mapgen/src/*"],
      "@adventure/sim": ["./packages/sim/src/index.ts"],
      "@adventure/sim/*": ["./packages/sim/src/*"],
      "@adventure/ai": ["./packages/ai/src/index.ts"],
      "@adventure/ai/*": ["./packages/ai/src/*"],
      "@adventure/protocol": ["./packages/protocol/src/index.ts"],
      "@adventure/protocol/*": ["./packages/protocol/src/*"],
      "@adventure/session": ["./packages/session/src/index.ts"],
      "@adventure/session/*": ["./packages/session/src/*"]
    },
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    // Ambient @types are opt-in per program: the engine packages run in a
    // browser as well as on a server, so nothing here may quietly depend on
    // Node's globals. `tools/tsconfig.json` opts back in.
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
