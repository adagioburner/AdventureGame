{
  // The server runs on Cloudflare Workers (docs/STACK.md §5), so this program
  // gets the Workers runtime's globals and nothing else: no DOM, no Node. Its
  // tests run under Vitest on Node, which has the same WebCrypto and
  // `btoa`/`atob` the Workers runtime provides, so the same types cover both.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["./src/**/*.ts"]
}
